{
    "name":  "backend",
    "version":  "0.1.0",
    "private":  true,
    "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "dev:debug": "nest start --watch --debug 0.0.0.0:9229",
