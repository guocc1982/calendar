generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  MEETING
  TRAVEL
  PERSONAL
  TASK
  THIRD_PARTY
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum AttendeeStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum Visibility {
  PUBLIC
  PRIVATE
  SHARE_LINK
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String   @unique
  plan      String   @default("basic")
  status    String   @default("active")
  samlConfig Json?
  features   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizations Organization[]
  users         User[]
  roles         Role[]
  thirdPartyApps ThirdPartyApp[]

  @@map("tenants")
}

model Organization {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  parentId  String?  @map("parent_id")
  name      String
  level     Int      @default(0)
  sortOrder Int      @default(0) @map("sort_order")
  managerId String?  @map("manager_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  parent   Organization? @relation("OrgHierarchy", fields: [parentId], references: [id])
  children Organization[] @relation("OrgHierarchy")
  users    User[]

  @@map("organizations")
}

model User {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  orgId       String?  @map("org_id")
  name        String
  email       String   @unique
  phone       String?
  password    String?
  samlId      String?  @map("saml_id")
  avatarUrl   String?  @map("avatar_url")
  status      String   @default("active")
  preferences Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  organization Organization?    @relation(fields: [orgId], references: [id])
  userRoles    UserRole[]
  events       Event[]
  attendees    EventAttendee[]
  notifications Notification[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  permissions Json
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String @map("user_id")
  roleId    String @map("role_id")
  scopeType String @map("scope_type")
  scopeId   String? @map("scope_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Event {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  userId         String      @map("user_id")
  summary        String
  description    String?
  startTime      DateTime    @map("start_time")
  endTime        DateTime    @map("end_time")
  timezone       String      @default("Asia/Shanghai")
  allDay         Boolean     @default(false) @map("all_day")
  eventType      EventType   @default(PERSONAL) @map("event_type")
  priority       Int         @default(0)
  status         EventStatus @default(CONFIRMED)
  location       Json?
  recurrence     String?
  extSource      String?     @map("ext_source")
  extEventId     String?     @map("ext_event_id")
  reminderConfig Json?       @map("reminder_config")
  visibility     Visibility  @default(PUBLIC)
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  createdBy      String      @map("created_by")

  user      User              @relation(fields: [userId], references: [id])
  attendees EventAttendee[]
  comments  EventComment[]

  @@unique([extSource, extEventId])
  @@index([tenantId, userId])
  @@index([startTime, endTime])
  @@map("events")
}

model EventAttendee {
  id              String         @id @default(uuid())
  eventId         String         @map("event_id")
  userId          String?        @map("user_id")
  name            String?
  email           String?
  required        Boolean        @default(true)
  status          AttendeeStatus @default(PENDING)
  respondedAt     DateTime?      @map("responded_at")
  extAttendeeName String?        @map("ext_attendee_name")

  event Event @relation(fields: [eventId], references: [id])
  user  User?  @relation(fields: [userId], references: [id])

  @@map("event_attendees")
}

model EventComment {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@map("event_comments")
}

model ThirdPartyApp {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  appName           String   @map("app_name")
  apiKeyHash        String   @map("api_key_hash")
  ipWhitelist       Json?    @map("ip_whitelist")
  allowedEventTypes Json?    @map("allowed_event_types")
  rateLimit         Int      @default(100) @map("rate_limit")
  expiresAt         DateTime? @map("expires_at")
  status            String   @default("active")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("third_party_apps")
}

model ApiAuditLog {
  id             String   @id @default(uuid())
  appId          String   @map("app_id")
  apiKeyId       String?  @map("api_key_id")
  eventType      String   @map("event_type")
  requestSummary String?  @map("request_summary")
  ipAddress      String?  @map("ip_address")
  result         String   @default("success")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("api_audit_logs")
}

model Notification {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  type           String
  title          String
  content        String?
  isRead         Boolean  @default(false) @map("is_read")
  relatedEventId String?  @map("related_event_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}
model Attachment {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  fileName  String   @map("file_name")
  fileSize  Int      @map("file_size")
  mimeType  String   @map("mime_type")
  filePath  String   @map("file_path")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@map("attachments")
}

model EventShare {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  token     String   @unique
  password  String?
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")

  event Event @relation(fields: [eventId], references: [id])

  @@map("event_shares")
}


